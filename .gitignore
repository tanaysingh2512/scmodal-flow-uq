# Checkpoints and large binary artifacts
*.pth
*.pt
*.npy
*.h5ad
CITE-seq_PBMC/

# CITE-seq_PBMC_v2/ holds the retrained checkpoint (large, .pth/.npy already
# ignored above) alongside one small, non-sensitive reproducibility fixture
# that IS tracked: rna_protein_correspondence.csv (~204 rows of gene/protein
# name pairs -- required so build_or_load_correspondence() never needs a
# live, non-deterministic mygene.info call again). Using `dir/*` rather than
# a bare `dir/` here is required for the negation below to actually work --
# git will not descend into a directory ignored via a bare trailing slash.
CITE-seq_PBMC_v2/*
!CITE-seq_PBMC_v2/rna_protein_correspondence.csv

CITE-seq_PBMC_v2_sg4*/

# TEA-seq_PBMC/ holds the checkpoint and large .npy artifacts (already
# ignored above via *.pth/*.npy) alongside one small, non-sensitive
# reproducibility fixture: TEA-seq_PBMC/data/tea-seq/protein_gene_conversion_new.csv
# (~46 rows, a static protein<->gene name mapping substituted from the
# MaxFuse repo -- required directly by build_teaseq_correspondence(), no
# generation fallback exists). This lives NESTED here, not at a top-level
# data/tea-seq/, because the original notebook's Section 2 cells changed
# working directory into TEA-seq_PBMC/ before loading it with a relative
# path. Same dir/* + negation idiom as CITE-seq_PBMC_v2/ above, one level
# deeper (nested twice: TEA-seq_PBMC/ then data/tea-seq/).
TEA-seq_PBMC/*
!TEA-seq_PBMC/data/
TEA-seq_PBMC/data/*
!TEA-seq_PBMC/data/tea-seq/
TEA-seq_PBMC/data/tea-seq/*
!TEA-seq_PBMC/data/tea-seq/protein_gene_conversion_new.csv

totalvi_model/
totalvi_results/

# Raw CITE-seq datasets (not included in this repo). No fixture lives
# directly under here -- a plain ignore is sufficient, no negation needed
# at this level. Anchored with a leading slash (/data/, not data/) --
# an unanchored `data/` pattern also matches TEA-seq_PBMC/data/ (gitignore
# patterns without a leading slash match at any directory depth), which
# would silently break the TEA-seq fixture negation above.
/data/

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/
*.egg-info/
.venv/
venv/

# OS
.DS_Store

# Results (regenerate via scripts/make_figures.py rather than committing)
results/figures/*.png
!results/figures/.gitkeep

# scMODAL upstream: tracked as a git submodule (git submodule add), not
# vendored. No ignore rule needed here.
